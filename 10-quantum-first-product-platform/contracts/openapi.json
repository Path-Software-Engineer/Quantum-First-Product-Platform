{
  "openapi": "3.0.3",
  "info": {
    "title": "Quantum-First Product Platform Control API",
    "version": "0.3.0",
    "description": "Tenant-scoped product publishing, evidence-bounded PQC reports and reviewed developer API documentation."
  },
  "servers": [{ "url": "http://127.0.0.1:8080" }],
  "tags": [
    { "name": "Health" },
    { "name": "Access" },
    { "name": "Catalog" },
    { "name": "Publishing" },
    { "name": "PQC reports" },
    { "name": "Developer docs" },
    { "name": "Public artifacts" }
  ],
  "paths": {
    "/health/live": {
      "get": {
        "tags": ["Health"],
        "operationId": "getLiveness",
        "security": [],
        "responses": { "200": { "description": "Process is live" } }
      }
    },
    "/health/ready": {
      "get": {
        "tags": ["Health"],
        "operationId": "getReadiness",
        "security": [],
        "responses": {
          "200": { "description": "Runtime database role is ready" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/access": {
      "get": {
        "tags": ["Access"],
        "operationId": "getWorkspaceAccess",
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": {
          "200": { "description": "Effective role and permissions" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/products": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "listProducts",
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": {
          "200": {
            "description": "Workspace products",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Product" }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Catalog"],
        "operationId": "createProduct",
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProduct" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created product",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Product" }
              }
            }
          },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/products/{productId}": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "getProduct",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/ProductId" }
        ],
        "responses": {
          "200": { "description": "Product and its versions" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/products/{productId}/versions": {
      "post": {
        "tags": ["Catalog"],
        "operationId": "createProductVersion",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/ProductId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateVersion" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created draft version" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/product-versions/{versionId}/capabilities": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "listCapabilities",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "responses": {
          "200": { "description": "Version capabilities" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "post": {
        "tags": ["Catalog"],
        "operationId": "createCapability",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCapability" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created capability" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/product-versions/{versionId}/use-cases": {
      "get": {
        "tags": ["Catalog"],
        "operationId": "listUseCases",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "responses": { "200": { "description": "Version use cases" } }
      },
      "post": {
        "tags": ["Catalog"],
        "operationId": "createUseCase",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateUseCase" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created use case" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/product-versions/{versionId}/evidence": {
      "post": {
        "tags": ["Publishing"],
        "operationId": "createEvidence",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateEvidence" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created evidence reference" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/product-versions/{versionId}/claims": {
      "get": {
        "tags": ["Publishing"],
        "operationId": "listClaims",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "responses": { "200": { "description": "Version claims" } }
      },
      "post": {
        "tags": ["Publishing"],
        "operationId": "createClaim",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateClaim" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created owned claim" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/product-versions/{versionId}/commercial-scenarios": {
      "post": {
        "tags": ["Publishing"],
        "operationId": "createCommercialScenario",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCommercialScenario"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created explicitly hypothetical scenario" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/product-versions/{versionId}/submit": {
      "post": {
        "tags": ["Publishing"],
        "operationId": "submitProductVersion",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "responses": {
          "201": { "description": "Version submitted for independent review" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/claims/{claimId}/review": {
      "post": {
        "tags": ["Publishing"],
        "operationId": "reviewClaim",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/ClaimId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReviewClaim" }
            }
          }
        },
        "responses": {
          "201": { "description": "Independent review recorded" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/product-versions/{versionId}/approve": {
      "post": {
        "tags": ["Publishing"],
        "operationId": "approveProductVersion",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "responses": {
          "201": { "description": "Version approved after policy checks" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/product-versions/{versionId}/publish": {
      "post": {
        "tags": ["Publishing"],
        "operationId": "publishProductVersion",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "responses": {
          "201": { "description": "Approved version published" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/product-versions/{versionId}/one-pager-builds": {
      "post": {
        "tags": ["Publishing"],
        "operationId": "buildOnePager",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "responses": {
          "201": {
            "description": "Immutable one-pager build with SHA-256",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OnePagerBuild" }
              }
            }
          },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/one-pager-builds/{buildId}": {
      "get": {
        "tags": ["Publishing"],
        "operationId": "getPrivateOnePagerBuild",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/BuildId" }
        ],
        "responses": {
          "200": {
            "description": "Tenant-owned one-pager build",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OnePagerBuild" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/audit-events": {
      "get": {
        "tags": ["Publishing"],
        "operationId": "listAuditEvents",
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }],
        "responses": {
          "200": { "description": "Latest governed workspace events" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/product-versions/{versionId}/pqc-assessments": {
      "post": {
        "tags": ["PQC reports"],
        "operationId": "createPqcAssessment",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/VersionId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePqcAssessment" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created evidence-bounded draft assessment" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/pqc-assessments/{assessmentId}": {
      "get": {
        "tags": ["PQC reports"],
        "operationId": "getPqcAssessment",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/AssessmentId" }
        ],
        "responses": {
          "200": {
            "description": "Assessment with inventory, recommendations and roadmap"
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/pqc-assessments/{assessmentId}/inventory": {
      "post": {
        "tags": ["PQC reports"],
        "operationId": "createCryptoInventoryItem",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/AssessmentId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCryptoInventoryItem"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created inventory item with deterministic score"
          },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/pqc-assessments/{assessmentId}/recommendations": {
      "post": {
        "tags": ["PQC reports"],
        "operationId": "createPqcRecommendation",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/AssessmentId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreatePqcRecommendation"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Created bounded recommendation" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/pqc-assessments/{assessmentId}/roadmap": {
      "post": {
        "tags": ["PQC reports"],
        "operationId": "createPqcRoadmapPhase",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/AssessmentId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreatePqcRoadmapPhase" }
            }
          }
        },
        "responses": {
          "201": { "description": "Created roadmap phase" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/pqc-assessments/{assessmentId}/review": {
      "post": {
        "tags": ["PQC reports"],
        "operationId": "reviewPqcAssessment",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/AssessmentId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReviewPqcAssessment" }
            }
          }
        },
        "responses": {
          "201": { "description": "Independent review recorded" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/pqc-assessments/{assessmentId}/report-builds": {
      "post": {
        "tags": ["PQC reports"],
        "operationId": "buildPqcReport",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/AssessmentId" }
        ],
        "responses": {
          "201": { "description": "Immutable PQC report build with SHA-256" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/pqc-report-builds/{buildId}/publish": {
      "post": {
        "tags": ["PQC reports"],
        "operationId": "publishPqcReport",
        "parameters": [
          { "$ref": "#/components/parameters/WorkspaceId" },
          { "$ref": "#/components/parameters/BuildId" }
        ],
        "responses": {
          "201": { "description": "Published reviewed report projection" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/v1/public/pqc-reports/{buildId}": {
      "get": {
        "tags": ["Public artifacts"],
        "operationId": "getPublishedPqcReport",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/BuildId" }],
        "responses": {
          "200": { "description": "Published evidence-bounded PQC report" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/public/one-pagers/{buildId}": {
      "get": {
        "tags": ["Public artifacts"],
        "operationId": "getPublishedOnePager",
        "security": [],
        "parameters": [{ "$ref": "#/components/parameters/BuildId" }],
        "responses": {
          "200": {
            "description": "Published projection without tenant or actor identifiers",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/PublicOnePager" }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/v1/workspaces/{workspaceId}/product-versions/{versionId}/developer-docs": {
      "post": {
        "tags": ["Developer docs"], "operationId": "createDeveloperDocs",
        "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/VersionId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateDeveloperDocs" } } } },
        "responses": { "201": { "description": "Created draft API documentation project" }, "404": { "$ref": "#/components/responses/NotFound" } }
      }
    },
    "/api/v1/workspaces/{workspaceId}/developer-docs/{documentId}": {
      "get": { "tags": ["Developer docs"], "operationId": "getDeveloperDocs", "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/DocumentId" }], "responses": { "200": { "description": "Structured documentation project" }, "404": { "$ref": "#/components/responses/NotFound" } } }
    },
    "/api/v1/workspaces/{workspaceId}/developer-docs/{documentId}/endpoints": {
      "post": { "tags": ["Developer docs"], "operationId": "createDocumentedEndpoint", "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/DocumentId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "201": { "description": "Created endpoint contract" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/workspaces/{workspaceId}/developer-docs/{documentId}/errors": {
      "post": { "tags": ["Developer docs"], "operationId": "createDocumentedError", "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/DocumentId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "201": { "description": "Created error documentation" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/workspaces/{workspaceId}/developer-docs/{documentId}/examples": {
      "post": { "tags": ["Developer docs"], "operationId": "createDeveloperExample", "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/DocumentId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "201": { "description": "Created copy-ready example" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/workspaces/{workspaceId}/developer-docs/{documentId}/quickstart": {
      "put": { "tags": ["Developer docs"], "operationId": "setDeveloperQuickstart", "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/DocumentId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "Upserted quickstart" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/workspaces/{workspaceId}/developer-docs/{documentId}/review": {
      "post": { "tags": ["Developer docs"], "operationId": "reviewDeveloperDocs", "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/DocumentId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["note"], "properties": { "note": { "type": "string" } } } } } }, "responses": { "201": { "description": "Independent review recorded" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/workspaces/{workspaceId}/developer-docs/{documentId}/builds": {
      "post": { "tags": ["Developer docs"], "operationId": "buildDeveloperDocs", "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/DocumentId" }], "responses": { "201": { "description": "Immutable Markdown build with SHA-256" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/workspaces/{workspaceId}/developer-doc-builds/{buildId}/publish": {
      "post": { "tags": ["Developer docs"], "operationId": "publishDeveloperDocs", "parameters": [{ "$ref": "#/components/parameters/WorkspaceId" }, { "$ref": "#/components/parameters/BuildId" }], "responses": { "201": { "description": "Published reviewed documentation projection and queued outbox event" }, "409": { "$ref": "#/components/responses/Conflict" } } }
    },
    "/api/v1/public/developer-docs/{buildId}": {
      "get": { "tags": ["Public artifacts"], "operationId": "getPublishedDeveloperDocs", "security": [], "parameters": [{ "$ref": "#/components/parameters/BuildId" }], "responses": { "200": { "description": "Published Markdown and structured developer documentation" }, "404": { "$ref": "#/components/responses/NotFound" } } }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "WorkspaceId": {
        "name": "workspaceId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "ProductId": {
        "name": "productId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "VersionId": {
        "name": "versionId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "ClaimId": {
        "name": "claimId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "BuildId": {
        "name": "buildId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "AssessmentId": {
        "name": "assessmentId",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      },
      "DocumentId": {
        "name": "documentId", "in": "path", "required": true,
        "schema": { "$ref": "#/components/schemas/Uuid" }
      }
    },
    "responses": {
      "Forbidden": {
        "description": "Workspace membership or permission denied"
      },
      "NotFound": {
        "description": "Resource not found in the authorized scope"
      },
      "Conflict": {
        "description": "Lifecycle or evidence policy rejected the operation"
      },
      "Unavailable": {
        "description": "Required runtime dependency unavailable"
      }
    },
    "schemas": {
      "Uuid": { "type": "string", "format": "uuid" },
      "Product": {
        "type": "object",
        "required": [
          "productId",
          "slug",
          "displayName",
          "summary",
          "createdBy",
          "createdAt"
        ],
        "properties": {
          "productId": { "$ref": "#/components/schemas/Uuid" },
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "displayName": { "type": "string" },
          "summary": { "type": "string" },
          "createdBy": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreateProduct": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slug", "displayName", "summary"],
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "displayName": { "type": "string", "maxLength": 160 },
          "summary": { "type": "string", "maxLength": 2000 }
        }
      },
      "CreateVersion": {
        "type": "object",
        "additionalProperties": false,
        "required": ["changeSummary"],
        "properties": {
          "changeSummary": { "type": "string", "maxLength": 1000 }
        }
      },
      "CreateCapability": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "title", "description", "maturity", "limitations"],
        "properties": {
          "key": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "maturity": {
            "type": "string",
            "enum": ["hypothesis", "planned", "available", "retired"]
          },
          "limitations": { "type": "string" },
          "sortOrder": { "type": "integer", "minimum": 0, "default": 0 }
        }
      },
      "CreateUseCase": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "actor",
          "problem",
          "workflow",
          "expectedOutcome",
          "evidenceStatus"
        ],
        "properties": {
          "key": { "type": "string" },
          "actor": { "type": "string" },
          "problem": { "type": "string" },
          "workflow": { "type": "string" },
          "expectedOutcome": { "type": "string" },
          "evidenceStatus": {
            "type": "string",
            "enum": ["hypothesis", "sourced"]
          }
        }
      },
      "CreateEvidence": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "sourceUri", "sourceKind", "notes"],
        "properties": {
          "title": { "type": "string" },
          "sourceUri": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://"
          },
          "sourceKind": {
            "type": "string",
            "enum": ["primary", "standard", "internal"]
          },
          "notes": { "type": "string" }
        }
      },
      "CreateClaim": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidenceId", "statement"],
        "properties": {
          "evidenceId": { "$ref": "#/components/schemas/Uuid" },
          "statement": { "type": "string", "maxLength": 2000 }
        }
      },
      "ReviewClaim": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "note"],
        "properties": {
          "decision": { "type": "string", "enum": ["approved", "rejected"] },
          "note": { "type": "string", "maxLength": 2000 }
        }
      },
      "CreateCommercialScenario": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "packaging", "pricing", "licensing", "assumptions"],
        "properties": {
          "key": { "type": "string" },
          "packaging": { "type": "string" },
          "pricing": {
            "type": "string",
            "description": "Explicitly hypothetical; never an executable quote."
          },
          "licensing": {
            "type": "string",
            "description": "Explicitly hypothetical; never executable license terms."
          },
          "assumptions": { "type": "string" }
        }
      },
      "OnePagerBuild": {
        "type": "object",
        "required": [
          "buildId",
          "versionId",
          "sourceSnapshot",
          "sourceSha256",
          "createdBy",
          "createdAt"
        ],
        "properties": {
          "buildId": { "$ref": "#/components/schemas/Uuid" },
          "versionId": { "$ref": "#/components/schemas/Uuid" },
          "sourceSnapshot": { "type": "object" },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "createdBy": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "PublicOnePager": {
        "type": "object",
        "required": [
          "buildId",
          "sourceSnapshot",
          "sourceSha256",
          "publishedAt"
        ],
        "properties": {
          "buildId": { "$ref": "#/components/schemas/Uuid" },
          "sourceSnapshot": { "type": "object" },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "publishedAt": { "type": "string", "format": "date-time" }
        }
      },
      "CreatePqcAssessment": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "industry",
          "criticalSystems",
          "sensitiveData",
          "maturity",
          "primaryConcern",
          "scope",
          "assumptions",
          "evidenceBasis"
        ],
        "properties": {
          "title": { "type": "string" },
          "industry": { "type": "string" },
          "criticalSystems": { "type": "string" },
          "sensitiveData": { "type": "string" },
          "maturity": {
            "type": "string",
            "enum": ["initial", "developing", "managed"]
          },
          "primaryConcern": { "type": "string" },
          "scope": { "type": "string" },
          "assumptions": { "type": "string" },
          "evidenceBasis": {
            "type": "string",
            "enum": [
              "self_reported",
              "document_review",
              "technical_observation"
            ]
          }
        }
      },
      "CreateDeveloperDocs": {
        "type": "object", "additionalProperties": false,
        "required": ["apiName", "apiVersion", "description", "authModel", "baseUrl", "rateLimits", "serviceStatus"],
        "properties": {
          "apiName": { "type": "string" }, "apiVersion": { "type": "string" },
          "description": { "type": "string" }, "authModel": { "type": "string" },
          "baseUrl": { "type": "string", "format": "uri" }, "rateLimits": { "type": "string" },
          "serviceStatus": { "type": "string", "enum": ["concept", "beta", "stable", "deprecated"] }
        }
      },
      "CreateCryptoInventoryItem": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "systemName",
          "algorithm",
          "protocol",
          "dataClass",
          "criticality",
          "exposure",
          "retention",
          "cryptoAgility",
          "evidenceNote"
        ],
        "properties": {
          "systemName": { "type": "string" },
          "algorithm": {
            "type": "string",
            "enum": ["RSA", "ECC", "HYBRID", "OTHER", "UNKNOWN"]
          },
          "protocol": { "type": "string" },
          "dataClass": { "type": "string" },
          "criticality": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "exposure": {
            "type": "string",
            "enum": ["internal", "partner", "internet"]
          },
          "retention": {
            "type": "string",
            "enum": ["short", "medium", "long"]
          },
          "cryptoAgility": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "evidenceNote": { "type": "string" }
        }
      },
      "CreatePqcRecommendation": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "itemId",
          "action",
          "priority",
          "dependency",
          "limitation"
        ],
        "properties": {
          "itemId": { "$ref": "#/components/schemas/Uuid" },
          "action": { "type": "string" },
          "priority": { "type": "string", "enum": ["low", "medium", "high"] },
          "dependency": { "type": "string" },
          "limitation": { "type": "string" }
        }
      },
      "CreatePqcRoadmapPhase": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phaseNumber",
          "title",
          "objective",
          "exitCriteria",
          "operationalRisks"
        ],
        "properties": {
          "phaseNumber": { "type": "integer", "minimum": 1, "maximum": 5 },
          "title": { "type": "string" },
          "objective": { "type": "string" },
          "exitCriteria": { "type": "string" },
          "operationalRisks": { "type": "string" }
        }
      },
      "ReviewPqcAssessment": {
        "type": "object",
        "additionalProperties": false,
        "required": ["note"],
        "properties": { "note": { "type": "string", "maxLength": 2000 } }
      }
    }
  },
  "security": [{ "bearerAuth": [] }]
}
