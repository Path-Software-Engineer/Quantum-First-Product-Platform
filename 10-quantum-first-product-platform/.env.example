NODE_ENV=development
PORT=8080
PORTAL_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=postgresql://p10_app:replace-me@127.0.0.1:5432/p10
AUTH_ISSUER=urn:p10:development
AUTH_AUDIENCE=urn:p10:control-api
# Development only. Use at least 32 random characters; never commit the real value.
AUTH_DEVELOPMENT_SECRET=replace-with-a-local-secret-of-at-least-32-characters
# Production uses a trusted HTTPS OIDC/JWKS endpoint and must omit AUTH_DEVELOPMENT_SECRET.
# AUTH_JWKS_URL=https://identity.example/.well-known/jwks.json
